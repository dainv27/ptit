<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox spacing="10.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="vn.dainv.server.ServerController">
    <padding>
        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0"/>
    </padding>
    <HBox spacing="8.0">
        <Label text="Sinh viên thực hiện:"/>
        <Label text="K24DTCN010 - Nguyễn Văn Đại"/>
    </HBox>
    <Label text="Server quản lý khách sạn (TCP/IP)"/>
    <HBox spacing="8.0">
        <Label text="Port:"/>
        <TextField fx:id="portField" prefWidth="100.0"/>
        <Button text="Khởi động" onAction="#onStartServer"/>
        <Button text="Dừng" onAction="#onStopServer"/>
    </HBox>
    <TextArea fx:id="logArea" prefHeight="420.0" wrapText="true"/>
</VBox>
