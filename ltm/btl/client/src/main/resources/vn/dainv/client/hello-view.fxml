<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox spacing="10.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="vn.dainv.client.ClientController">
    <padding>
        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0"/>
    </padding>
    <HBox spacing="8.0">
        <Label text="Sinh viên thực hiện:"/>
        <Label text="K24DTCN010 - Nguyễn Văn Đại"/>
    </HBox>
    <HBox spacing="8.0">
        <Label text="Host"/>
        <TextField fx:id="hostField" prefWidth="140.0"/>
        <Label text="Port"/>
        <TextField fx:id="portField" prefWidth="90.0"/>
        <Button text="Kết nối" onAction="#onConnect"/>
    </HBox>

    <TabPane tabClosingPolicy="UNAVAILABLE">
        <tabs>
            <Tab text="Khách sạn">
                <VBox spacing="8.0">
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                    </padding>
                    <Label text="Sử dụng form popup để nhập dữ liệu khách sạn"/>
                    <HBox spacing="8.0">
                        <Button text="Thêm" onAction="#onAddHotel"/>
                        <Button text="Danh sách" onAction="#onListHotels"/>
                    </HBox>
                    <TableView fx:id="hotelTable" prefHeight="220.0">
                        <columns>
                            <TableColumn fx:id="hotelIdColumn" prefWidth="120.0" text="Mã KS"/>
                            <TableColumn fx:id="hotelNameColumn" prefWidth="180.0" text="Tên khách sạn"/>
                            <TableColumn fx:id="hotelStarsColumn" prefWidth="80.0" text="Số sao"/>
                            <TableColumn fx:id="hotelDescColumn" prefWidth="300.0" text="Mô tả"/>
                            <TableColumn fx:id="hotelActionColumn" prefWidth="180.0" text="Thao tác"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
            <Tab text="Phòng">
                <VBox spacing="8.0">
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                    </padding>
                    <Label text="Sử dụng form popup để nhập dữ liệu phòng"/>
                    <HBox spacing="8.0">
                        <Label text="Khách sạn"/>
                        <ComboBox fx:id="roomHotelFilterComboBox" prefWidth="220.0"/>
                        <Button text="Thêm" onAction="#onAddRoom"/>
                        <Button text="Danh sách" onAction="#onListRooms"/>
                        <Button text="Tìm phòng" onAction="#onSearchRooms"/>
                    </HBox>
                    <TableView fx:id="roomTable" prefHeight="220.0">
                        <columns>
                            <TableColumn fx:id="roomHotelIdColumn" prefWidth="120.0" text="Mã KS"/>
                            <TableColumn fx:id="roomIdColumn" prefWidth="120.0" text="Mã phòng"/>
                            <TableColumn fx:id="roomTypeColumn" prefWidth="180.0" text="Loại phòng"/>
                            <TableColumn fx:id="roomPriceColumn" prefWidth="120.0" text="Giá"/>
                            <TableColumn fx:id="roomActionColumn" prefWidth="180.0" text="Thao tác"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
        </tabs>
    </TabPane>
    <TextArea fx:id="outputArea" prefHeight="260.0" wrapText="true"/>
</VBox>
